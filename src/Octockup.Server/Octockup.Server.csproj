		<Folder Include="wwwroot\" />
		<PackageReference Include="Mapster" Version="10.0.12" />
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="EasyVault" Version="1.0.14" />
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
		<PackageReference Include="FluentFTP" Version="54.2.0" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="EasyExtensions.Quartz" Version="3.0.80" />
		<PackageReference Include="EasyExtensions.Crypto" Version="3.0.80" />
		<PackageReference Include="EasyExtensions.AspNetCore" Version="3.0.80" />
		<PackageReference Include="EasyExtensions.EntityFrameworkCore" Version="3.0.80" />
		<PackageReference Include="EasyExtensions.Mediator" Version="3.0.80" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.11" />
		<PackageReference Include="EasyExtensions.AspNetCore.Authorization" Version="3.0.80" />
		<PackageReference Include="EasyExtensions.EntityFrameworkCore.Npgsql" Version="3.0.80" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
