{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "Auth:Octockup",
    "Audience": "Octockup:Client",
    "LifetimeMinutes": 10
  },
  "BackupExecution": {
    "MaxConcurrentBackups": 4,
    "MaxChunkLookupMemoryBytes": 67108864
  },
  "DownloadTickets": {
    "Lifetime": "00:02:00"
  },
  "RefreshSessions": {
    "Lifetime": "30.00:00:00"
  },
  "DatabaseSettings": {
    "Port": 5432,
    "Host": "postgres-server",
    "Username": "octockup_client",
    "Database": "octockup"
  }
}
