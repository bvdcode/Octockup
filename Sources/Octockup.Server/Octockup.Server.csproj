<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>616c9d5a-c31a-4b5d-a4e4-cb09234d1690</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<SpaRoot>..\octockup.client</SpaRoot>
		<SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
		<SpaProxyServerUrl>https://localhost:51031</SpaProxyServerUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="Mapster" Version="7.4.0" />
		<PackageReference Include="FluentFTP" Version="53.0.2" />
		<PackageReference Include="AWSSDK.S3" Version="4.0.13.1" />
		<PackageReference Include="FluentValidation" Version="12.1.0" />
		<PackageReference Include="EasyExtensions.Quartz" Version="2.0.40" />
		<PackageReference Include="EasyExtensions.Crypto" Version="2.0.40" />
		<PackageReference Include="EasyExtensions.AspNetCore" Version="2.0.40" />
		<PackageReference Include="EasyExtensions.EntityFrameworkCore" Version="2.0.40" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.0" />
		<PackageReference Include="EasyExtensions.AspNetCore.Authorization" Version="2.0.40" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy">
			<Version>10.0.0</Version>
		</PackageReference>
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
		<ProjectReference Include="..\octockup.client\octockup.client.esproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>
		<Folder Include="wwwroot\" />
	</ItemGroup>

</Project>
